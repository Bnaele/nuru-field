# Copy this file to backend/.env and fill in the values you need.
#
# backend/.env is gitignored. Never commit it.
#
# Two of the three services below are optional:
#
#   Supabase    required for plants, watering and photo history
#   Gemini      required for the photo analysis and the chat adviser
#   Everything else (weather, soil, region, crop data, market prices) uses
#   keyless public sources and works with this file completely empty.
#
# Start the API with:  cd backend && uvicorn main:app --reload
# Check what is wired up at:  http://localhost:8000/api/health

# --- Google Gemini (photo analysis + chat adviser) ---------------------------
# https://aistudio.google.com/apikey -- the free tier is enough for a pilot.
# Leave blank to run without AI: /api/health will report ai_configured: false
# and the AI routes return 503 instead of crashing.
GEMINI_API_KEY=
# 2.5-series models are closed to new API keys. Override only if your project
# has access to a different model.
GEMINI_MODEL=gemini-3.6-flash

# --- Supabase (database + auth) ----------------------------------------------
# Project settings -> API. The service key is under "secret keys" / "service_role".
#
# The service key bypasses Row Level Security. It is only ever read server-side in
# backend/db.py and must never appear in the frontend build. The browser gets the
# anon key instead (frontend/.env, VITE_SUPABASE_ANON_KEY).
#
# Apply backend/schema.sql to this project once, then run: python backend/seed.py
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- CORS --------------------------------------------------------------------
# Comma-separated origins allowed to call the API. The default matches Vite.
CORS_ORIGINS=http://localhost:5173

# --- Optional overrides -------------------------------------------------------
# Nominatim asks every client to identify itself. Set this to a URL with your own
# contact details if you deploy your own copy.
# HTTP_USER_AGENT=NuruField/0.2 (+https://github.com/your-handle/nuru-field)

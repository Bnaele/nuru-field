# Copy this file to frontend/.env and fill in the two Supabase values.
#
# frontend/.env is gitignored. Never commit it.
#
# Vite only exposes variables that start with VITE_, and it inlines them into the
# built JavaScript. That means anything here is public: only ever put the anon key
# in this file. The Supabase service key belongs in backend/.env and must never
# appear here.

# Project settings -> API -> Project URL
VITE_SUPABASE_URL=

# Project settings -> API -> anon / public key
# Safe to expose. Row Level Security in backend/schema.sql decides what it can
# actually read, which for this app is nothing by default.
VITE_SUPABASE_ANON_KEY=

# Where the FastAPI backend is listening.
# Local development: http://localhost:8000
# Deployed: set this to your Render URL, e.g. https://nuru-field-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Without the two Supabase values the app still starts, but it renders a
# configuration banner instead of the app rather than white-screening.

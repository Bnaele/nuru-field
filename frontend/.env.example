# Copy this file to frontend/.env and fill in both values.
#
# frontend/.env is gitignored. Never commit it.
#
# These two values are the only ones the browser needs. They come from your
# Supabase project under Project settings -> API:
#
#   VITE_SUPABASE_URL       the Project URL
#   VITE_SUPABASE_ANON_KEY  the "anon" / "publishable" key
#
# Vite inlines both into the JavaScript bundle at build time, which is expected:
# the anon key is designed to be public and Row Level Security is what protects
# the data. The service key is a different value and must never be put here —
# the app detects that case and refuses to start.
#
# Vite only reads this file at startup. Restart `npm run dev` after editing it.
# Without these values the app shows a configuration notice instead of a sign-in
# screen, rather than crashing to a white page.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the FastAPI service is reachable. The default matches a local backend
# started with `cd backend && uvicorn main:app --reload`.
# Deployed: set this to your Render URL, e.g. https://nuru-field-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000
